<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    colors="true"
    backupGlobals="false"
    stopOnFailure="false"
    cacheDirectory=".phpunit.cache"
    backupStaticProperties="false"
>
    <coverage ignoreDeprecatedCodeUnits="true" />

    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
        <testsuite name="Exception">
            <directory suffix="Test.php">./tests/Exception</directory>
        </testsuite>
    </testsuites>

    <php>
        <env name="AUTH_TOKEN_TYPE" value="bearer"/>
        <env name="APP_NAME" value="Testbench"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:dY2RGwL3lXtuyRgSV5UQNAdVmJpe8b4dOremiVpHn7w="/>
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="AWS_COGNITO_VERSION" value="latest"/>
        <env name="AWS_COGNITO_ADD_USER_DELIVERY_MEDIUMS" value="EMAIL"/>
        <env name="AWS_COGNITO_TOKEN_STORAGE" value="file"/>
        <env name="AWS_COGNITO_FORCE_NEW_USER_PASSWORD" value="false"/>
        <env name="AWS_COGNITO_ALLOW_PHONE_NUMBER" value="false"/>
    </php>

    <source>
        <include>
            <directory suffix=".php">src/</directory>
        </include>
    </source>

    <logging>
        <junit outputFile="build/reports/junit.xml"/>
        <teamcity outputFile="build/reports/teamcity.txt"/>
        <testdoxHtml outputFile="build/reports/testdox.html"/>
        <testdoxText outputFile="build/reports/testdox.txt"/>
    </logging>
</phpunit>
