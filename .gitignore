# Ignore the following files
.DS_Store
composer.phar
composer.lock
.phpunit.result.cache

# Ignore following directories
/.phpunit.cache
/vendor
/tests/reports
/build
/skills

# Ignore npm modules and files
/node_modules
/dist
package-lock.json
npm-debug.log
yarn.lock

# Ignore workbench files and directories
/workbench/.env
/workbench/storage
/workbench/config/*
!/workbench/config/auth.php

# Whitelist all .gitkeep files
!**/.gitkeep
