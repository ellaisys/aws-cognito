{
    "name": "ellaisys/aws-cognito",
    "description": "Laravel Authentication using AWS Cognito (Web and API)",
    "keywords": [
        "php",
        "laravel",
        "aws",
        "cognito",
        "aws cognito",
        "auth",
        "authentication",
        "oauth",
        "user pool",
        "ellaisys",
        "mfa",
        "multi-factor authentication",
        "2fa",
        "two-factor authentication",
        "password",
        "reset",
        "forgot password",
        "change password",
        "update password",
        "email",
        "phone",
        "sms",
        "verification",
        "user confirmation",
        "access token",
        "reset token",
        "email recovery",
        "verify code",
        "confirm code",
        "sms",
        "token verify",
        "aws sdk",
        "aws sdk php",
        "identity pool",
        "srp protocol",
        "secure remote password protocol",
        "device authentication",
        "fido",
        "fido2",
        "webauthn",
        "passkey",
        "passwordless",
        "jwt",
        "json web token",
        "jwt token"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://ellaisys.github.io/aws-cognito/",
    "readme": "README.md",
    "authors": [
        {
            "name": "EllaiSys",
            "email": "ellaisys@gmail.com",
            "role": "owner",
            "homepage": "https://ellaisys.github.io/"
        },
        {
            "name": "Amit Dhongde",
            "email": "ellaisys+amit.dhongde@gmail.com",
            "role": "owner",
            "homepage": "https://ellaisys.github.io/"
        }
    ],
    "support": {
        "email": "ellaisys@gmail.com",
        "issues": "https://github.com/ellaisys/aws-cognito/issues",
        "source": "https://github.com/ellaisys/aws-cognito"
    },
    "prefer-stable": true,
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^7.4|^8.0",
        "ext-gmp": "*",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/log": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/pagination": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.10",
        "firebase/php-jwt": "^7.0",
        "aws/aws-sdk-php": "^3.380",
        "symfony/console": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^5.4|^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": ">=9.0",
        "orchestra/testbench": "^8.36|^9.15|^10.8|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ellaisys\\Cognito\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ellaisys\\Cognito\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ellaisys\\Cognito\\Providers\\AwsCognitoServiceProvider"
            ],
            "aliases": []
        },
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": [
            "@clear",
            "@php vendor/bin/phpunit"
        ]
    }
}